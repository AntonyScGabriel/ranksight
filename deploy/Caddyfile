# Reverse proxy HTTPS : certificats Let's Encrypt automatiques et renouvelés.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	import common
	reverse_proxy admin:3001
}

{$API_DOMAIN} {
	import common
	# Vidéos envoyées par les joueurs (80 Mo maximum)
	request_body {
		max_size 90MB
	}
	reverse_proxy api:4000
}
