# Configuration de RankGuess. `npm run dev` crée automatiquement .env à partir de ce fichier.
# Les valeurs ci-dessous fonctionnent telles quelles en local avec Docker.

# ---------- API ----------
NODE_ENV=development
API_PORT=4000
# Adresses publiques. Aucune adresse n'est écrite en dur dans le code : tout part d'ici.
# En production, par exemple :
#   API_PUBLIC_URL=https://api.rankguess.fr
#   WEB_URL=https://rankguess.fr
#   ADMIN_URL=https://admin.rankguess.fr
#   CORS_ORIGINS=https://rankguess.fr,https://admin.rankguess.fr
# API_PUBLIC_URL sert à construire les adresses de retour Google et Discord :
#   <API_PUBLIC_URL>/v1/auth/oauth/google/callback et <API_PUBLIC_URL>/v1/auth/oauth/discord/callback
API_PUBLIC_URL=http://localhost:4000
# WEB_URL sert aussi aux liens envoyés par email (mot de passe oublié)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Classement saisonnier : une saison = un mois civil. Mois de la saison 1 (AAAA-MM).
SEASON_ONE=2026-10
# Schéma des liens de l'application mobile (identique à "scheme" dans apps/mobile/app.json)
APP_SCHEME=ranksight

DATABASE_URL=postgresql://ranksight:ranksight@localhost:5432/ranksight
REDIS_URL=redis://localhost:6379

# JWT : en local ces valeurs suffisent ; en production, générer avec `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Connexion Google : https://console.cloud.google.com/apis/credentials (ID client OAuth, application Web)
#   URI de redirection autorisée en local      : http://localhost:4000/v1/auth/oauth/google/callback
#   URI de redirection autorisée en production : <API_PUBLIC_URL>/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion Discord : https://discord.com/developers/applications → OAuth2 → Redirects
#   En local      : http://localhost:4000/v1/auth/oauth/discord/callback
#   En production : <API_PUBLIC_URL>/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Emails (mot de passe oublié). Sans SMTP_HOST, le lien de réinitialisation est écrit dans le terminal de l'API.
# Exemples de fournisseurs : Brevo, Mailjet, Resend (SMTP), Gmail (mot de passe d'application).
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RankGuess <no-reply@example.com>"

# Stockage vidéo
# local = les vidéos vont dans apps/api/storage et l'API les sert (rien à installer)
# s3    = Cloudflare R2 en production (remplir les S3_* ci-dessous)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Compression des vidéos (720p) : ffmpeg doit être installé (https://ffmpeg.org/download.html).
# Vide = « ffmpeg » et « ffprobe » trouvés dans le PATH. Sans ffmpeg, les vidéos sont gardées telles quelles.
FFMPEG_PATH=
FFPROBE_PATH=

# Boutique VIP (paiement par carte avec Stripe Checkout). Sans clé, la boutique s'affiche mais l'achat est indisponible.
# Test gratuit : dashboard.stripe.com → mode Test → Développeurs → Clés API → « Clé secrète » (sk_test_…).
# Carte de test : 4242 4242 4242 4242, date future, CVC au choix.
STRIPE_SECRET_KEY=
# Facultatif en local (l'achat est validé au retour sur la boutique). En production : Développeurs → Webhooks →
# point de terminaison <API_PUBLIC_URL>/v1/shop/webhook, événement checkout.session.completed → « Clé secrète de signature ».
STRIPE_WEBHOOK_SECRET=

# Achat du VIP dans l'application Android (Google Play Billing). Vides = achat indisponible dans l'application.
# Identifiant de l'application sur Google Play (le même que ANDROID_PACKAGE du build mobile).
GOOGLE_PLAY_PACKAGE_NAME=
# Clé JSON du compte de service Google Cloud invité dans la Play Console (voir README, « Publier sur Google Play »).
# Coller le contenu du fichier JSON sur une ligne, ou son encodage base64 (base64 -w0 cle.json).
GOOGLE_PLAY_SERVICE_ACCOUNT=

# ---------- Sécurité ----------
# Clé de chiffrement des données sensibles (secret de double authentification). Vide = dérivée de JWT_REFRESH_SECRET.
ENCRYPTION_KEY=
# Double authentification pour l'administration : false = facultative, true = obligatoire, auto = obligatoire en production
ADMIN_REQUIRE_2FA=false
# Adresse qui reçoit les messages du formulaire de contact (vide = adresse de MAIL_FROM)
CONTACT_EMAIL=
# Suivi des erreurs Sentry (facultatif) : API et site
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Informations légales affichées sur le site ----------
# Mentions légales, CGV et politique de confidentialité. À remplir avant la mise en ligne.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_SIRET=
LEGAL_VAT_NOTE=
LEGAL_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_CONTACT=
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
