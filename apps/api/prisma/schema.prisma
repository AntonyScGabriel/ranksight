// =============================================================================
// RankGuess — modèle de données (PostgreSQL 17, Prisma 7)
// Conventions : UUID v7 côté app, snake_case en base, timestamps UTC,
// soft-delete uniquement sur User (RGPD : anonymisation, pas d'effacement en cascade des scores).
//
// Objets créés en SQL par les migrations, absents de ce fichier (Prisma ne sait pas les décrire) : contraintes CHECK,
// contrainte d'exclusion `seasons_no_overlap`, index unique partiel `rooms_system_slot_lobby_key`, déclencheur et
// fonction `audit_logs_append_only`, schéma `archive`. Une migration générée par Prisma peut contenir
// `DROP INDEX "rooms_system_slot_lobby_key"` : retirer cette ligne avant de l'appliquer. Liste complète vérifiée par
// apps/api/test/integration/schema-objects.test.mjs ; procédure : README, « Migrations sûres ».
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Utilisateurs & authentification
// ----------------------------------------------------------------------------

enum Role {
  USER
  REVIEWER  // trieur de clips : pré-valide ou pré-refuse les clips proposés, sans autre accès
  MODERATOR
  ADMIN
  OWNER     // fondateur : propriétaire unique du site, intouchable par l'équipe ; seul lui gère les administrateurs
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  DISCORD
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String?    @unique // toujours stocké en minuscules
  /// Email confirmé : par Google/Discord (email vérifié) ou par un lien de réinitialisation reçu
  emailVerifiedAt DateTime?  @map("email_verified_at")
  /// Compte classique : hash scrypt du mot de passe (jamais le mot de passe lui-même). NULL = connexion Google/Discord uniquement
  passwordHash    String?    @map("password_hash")
  /// Pseudo RankGuess en minuscules, unique : garantit qu'aucun joueur ne porte le même pseudo, quelle que soit la casse
  username        String     @unique
  /// Pseudo RankGuess tel qu'affiché (même valeur que username, casse conservée)
  displayName     String     @map("display_name") @db.VarChar(32)
  avatarUrl       String?    @map("avatar_url")
  /// Photo envoyée par le joueur (clé du fichier dans le stockage), supprimée quand elle est remplacée ou retirée
  avatarKey       String?    @map("avatar_key")
  /// Récompenses équipées (titre sous le pseudo, badge à côté du pseudo, cadre autour de l'avatar)
  titleId         String?    @map("title_id") @db.Uuid
  badgeId         String?    @map("badge_id") @db.Uuid
  frameId         String?    @map("frame_id") @db.Uuid
  timezone        String     @default("Europe/Paris")
  locale          String     @default("fr")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)

  // Progression (dénormalisée pour lecture rapide ; source = table guesses)
  xp              Int        @default(0)
  level           Int        @default(1)
  dailyStreak     Int        @default(0) @map("daily_streak")
  bestDailyStreak Int        @default(0) @map("best_daily_streak")
  lastDailyDate   DateTime?  @map("last_daily_date") @db.Date
  infiniteBest    Int        @default(0) @map("infinite_best")
  /// Série de victoires : réponses exactes consécutives (tous modes confondus)
  winStreak       Int        @default(0) @map("win_streak")
  bestWinStreak   Int        @default(0) @map("best_win_streak")
  totalGuesses    Int        @default(0) @map("total_guesses")
  exactGuesses    Int        @default(0) @map("exact_guesses")
  /// Statistiques remises à zéro par l'équipe (faille exploitée) : les réponses antérieures ne comptent plus
  statsResetAt    DateTime?  @map("stats_reset_at")
  /// Acceptation des CGU (et déclaration d'avoir 15 ans ou plus) : date et version des CGU acceptées
  termsAcceptedAt DateTime?  @map("terms_accepted_at")
  termsVersion    String?    @map("terms_version")
  /// Chat coupé par la modération jusqu'à cette date (messages privés et chat global)
  chatMutedUntil  DateTime?  @map("chat_muted_until")
  /// Double authentification (TOTP) : secret chiffré (AES-256-GCM) et date d'activation
  totpSecret      String?    @map("totp_secret")
  totpEnabledAt   DateTime?  @map("totp_enabled_at")
  /// Codes de secours de la double authentification (hash SHA-256, usage unique)
  totpRecovery    String[]   @default([]) @map("totp_recovery")

  notifyDaily     Boolean    @default(true) @map("notify_daily")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  guesses          Guess[]
  infiniteRuns     InfiniteRun[]
  achievements     UserAchievement[]
  gameStats        UserGameStats[]
  reports          Report[]           @relation("reporter")
  resolvedReports  Report[]           @relation("resolver")
  uploadedClips    Clip[]             @relation("uploader")
  reviewedClips    Clip[]             @relation("reviewer")
  triagedClips     Clip[]             @relation("triager")
  friendsSent      Friendship[]       @relation("requester")
  friendsReceived  Friendship[]       @relation("addressee")
  subscription     Subscription?
  purchases        Purchase[]         @relation("buyer")
  versusCreated    VersusMatch[]      @relation("versusCreator")
  versusJoined     VersusMatch[]      @relation("versusOpponent")
  versusWon        VersusMatch[]      @relation("versusWinner")
  roomsHosted      Room[]             @relation("roomHost")
  roomsCreated     Room[]             @relation("roomCreator")
  roomSeats        RoomPlayer[]
  roomInvites      RoomInvite[]       @relation("roomInvitee")
  roomInvitesSent  RoomInvite[]       @relation("roomInviter")
  tournamentsCreated Tournament[]     @relation("tournamentCreator")
  tournamentsHosted  Tournament[]     @relation("tournamentHost")
  tournamentSeats    TournamentPlayer[]
  ratings          CompetitiveRating[]
  ratingChanges    RatingChange[]
  higherLowerRuns  HigherLowerRun[]
  seasonResults    CompetitiveSeasonResult[]
  grantedPurchases Purchase[]         @relation("granter")
  giftsReceived    Purchase[]         @relation("giftRecipient")
  giftCodesCreated GiftCode[]         @relation("giftCodeCreator")
  giftRedemptions  GiftRedemption[]
  pushTokens       PushToken[]
  leaderboardRows  LeaderboardSnapshot[]
  auditLogs        AuditLog[]
  messagesSent     DirectMessage[]    @relation("sender")
  messagesReceived DirectMessage[]    @relation("recipient")
  passwordResets   PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  blocking         UserBlock[]        @relation("blocker")
  blockedBy        UserBlock[]        @relation("blocked")
  chatReportsMade  ChatReport[]       @relation("chatReporter")
  chatReportsAbout ChatReport[]       @relation("chatTarget")
  chatReportsDone  ChatReport[]       @relation("chatResolver")
  globalMessages   GlobalMessage[]    @relation("author")
  moderatedGlobal  GlobalMessage[]    @relation("moderator")
  gameChat         GameChatMessage[]
  cosmetics        UserCosmetic[]     @relation("owner")
  cosmeticsGranted UserCosmetic[]     @relation("granter")
  suggestions      Suggestion[]       @relation("suggestionAuthor")
  suggestionsReplied Suggestion[]     @relation("suggestionReplier")
  title            Cosmetic?          @relation("equippedTitle", fields: [titleId], references: [id], onDelete: SetNull)
  badge            Cosmetic?          @relation("equippedBadge", fields: [badgeId], references: [id], onDelete: SetNull)
  frame            Cosmetic?          @relation("equippedFrame", fields: [frameId], references: [id], onDelete: SetNull)

  @@index([xp(sort: Desc)])
  @@map("users")
}

/// Lien de confirmation de l'adresse email : seul le hash SHA-256 du jeton est stocké, valable 48 heures, à usage unique.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Joueur bloqué : plus de messages privés, de demandes d'ami ni de duels entre eux ; ses messages du chat global sont masqués.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Lien « mot de passe oublié » : seul le hash SHA-256 du jeton est stocké, valable 1 heure, à usage unique.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  providerUsername  String?       @map("provider_username")
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Refresh tokens rotatifs : on ne stocke que le hash SHA-256.
/// `familyId` permet de révoquer toute la chaîne en cas de réutilisation détectée.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

// ----------------------------------------------------------------------------
// Catalogue : jeux, rangs, clips
// ----------------------------------------------------------------------------

model Game {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  iconUrl   String?  @map("icon_url")
  accent    String   @default("#7C3AED")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  ranks       Rank[]
  clips       Clip[]
  stats       UserGameStats[]
  achievements Achievement[]
  dailies     DailyChallenge[]
  versus      VersusMatch[]
  rooms       Room[]
  tournaments Tournament[]
  higherLowerRuns HigherLowerRun[]

  @@map("games")
}

/// `order` est la position absolue du rang dans l'échelle du jeu (0 = plus bas).
/// L'écart de score = |order(réponse) − order(réel)|.
model Rank {
  id       String  @id @default(uuid(7)) @db.Uuid
  gameId   String  @map("game_id") @db.Uuid
  name     String
  tier     String
  division Int?
  order    Int
  iconUrl  String? @map("icon_url")
  color    String  @default("#A78BFA")

  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  clips   Clip[]
  guesses Guess[]
  icon    RankIcon?

  @@unique([gameId, order])
  @@unique([gameId, name])
  @@map("ranks")
}

/// Image d'un rang, envoyée depuis l'administration (PNG, JPEG ou WebP, 512 Ko max).
/// Sans image, les écrans affichent un emblème généré aux couleurs du rang.
model RankIcon {
  rankId    String   @id @map("rank_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  rank Rank @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@map("rank_icons")
}

enum ClipStatus {
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum TriageDecision {
  APPROVE
  REJECT
}

enum ClipLinkProvider {
  YOUTUBE
  MEDAL
}

enum ClipSource {
  ADMIN
  COMMUNITY
}

model Clip {
  id              String     @id @default(uuid(7)) @db.Uuid
  gameId          String     @map("game_id") @db.Uuid
  rankId          String     @map("rank_id") @db.Uuid
  uploaderId      String     @map("uploader_id") @db.Uuid
  reviewerId      String?    @map("reviewer_id") @db.Uuid
  source          ClipSource @default(ADMIN)
  status          ClipStatus @default(PROCESSING)

  /// Fichier vidéo ; pour un clip proposé par un lien : clé « link/<fournisseur>/<vidéo>/<début> » (aucun fichier)
  storageKey      String     @unique @map("storage_key")
  /// Clip proposé par un lien YouTube ou Medal : vidéo lue avec leur lecteur intégré, jamais téléchargée ni stockée
  linkProvider    ClipLinkProvider? @map("link_provider")
  linkVideoId     String?    @map("link_video_id") @db.VarChar(64)
  /// Début du passage joué dans la vidéo YouTube (secondes) ; la fin est début + durationSec
  linkStartSec    Int?       @map("link_start_sec")
  hlsKey          String?    @map("hls_key")
  posterKey       String?    @map("poster_key")
  durationSec     Float      @map("duration_sec")
  difficulty      Int        @default(3) // 1..5, recalculée selon l'écart moyen des joueurs

  /// Preuve du rang (lien match history, capture tracker…) — visible admin uniquement
  proofUrl        String?    @map("proof_url")
  creatorConsent  Boolean    @default(false) @map("creator_consent")
  /// Pseudo du joueur filmé, tel qu'il apparaît dans le jeu (distinct du pseudo RankGuess de l'auteur de l'envoi)
  inGamePseudo    String?    @map("in_game_pseudo") @db.VarChar(32)
  platform        String?    @db.VarChar(20)
  region          String?    @db.VarChar(20)
  /// Message du joueur qui propose le clip (contexte, match…) — visible par la modération
  submitterNote   String?    @map("submitter_note") @db.VarChar(300)
  /// Motif communiqué au joueur quand le clip est refusé
  rejectionReason String?    @map("rejection_reason") @db.VarChar(300)
  reviewedAt      DateTime?  @map("reviewed_at")
  /// Pré-tri par un trieur de clips : avis à confirmer par la modération (le clip reste en attente)
  triageDecision  TriageDecision? @map("triage_decision")
  /// Motif du pré-refus ou remarque pour la modération
  triageNote      String?    @map("triage_note") @db.VarChar(300)
  triagedById     String?    @map("triaged_by_id") @db.Uuid
  triagedAt       DateTime?  @map("triaged_at")
  /// Suppression par la modération : le clip disparaît partout, ses réponses restent dans les statistiques
  deletedAt       DateTime?  @map("deleted_at")

  /// Compression (720p, H.264) : date, taille d'origine et taille stockée
  processedAt       DateTime? @map("processed_at")
  originalSizeBytes Int?      @map("original_size_bytes")
  sizeBytes         Int?      @map("size_bytes")
  /// Fichiers vidéo supprimés du stockage (clip refusé depuis longtemps ou supprimé) : la fiche reste pour l'historique
  fileDeletedAt     DateTime? @map("file_deleted_at")

  // Statistiques agrégées (mises à jour par job)
  timesPlayed     Int        @default(0) @map("times_played")
  avgDistance     Float      @default(0) @map("avg_distance")
  reportCount     Int        @default(0) @map("report_count")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  game      Game             @relation(fields: [gameId], references: [id])
  rank      Rank             @relation(fields: [rankId], references: [id])
  uploader  User             @relation("uploader", fields: [uploaderId], references: [id])
  reviewer  User?            @relation("reviewer", fields: [reviewerId], references: [id])
  triagedBy User?            @relation("triager", fields: [triagedById], references: [id], onDelete: SetNull)
  guesses   Guess[]
  reports   Report[]
  dailies   DailyChallenge[]
  versus    VersusClip[]
  roomRounds RoomRound[]

  @@unique([id, gameId])
  @@index([status, gameId, difficulty])
  @@index([status, createdAt])
  @@index([uploaderId, createdAt(sort: Desc)])
  @@index([triagedById])
  @@map("clips")
}

/// Un défi par jour ET par jeu, identique pour tous. Planifié par la modération, ou tiré au sort parmi les clips acceptés du jeu.
/// La clé étrangère (clip_id, game_id) garantit que le clip appartient bien au jeu du défi.
model DailyChallenge {
  id        String   @id @default(uuid(7)) @db.Uuid
  date      DateTime @db.Date
  gameId    String   @map("game_id") @db.Uuid
  /// Numéro du défi du jour pour ce jeu (1 à DAILY_PER_GAME)
  slot      Int      @default(1)
  clipId    String   @map("clip_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  game    Game    @relation(fields: [gameId], references: [id])
  clip    Clip    @relation(fields: [clipId, gameId], references: [id, gameId])
  guesses Guess[]

  @@unique([date, gameId, slot])
  @@index([clipId])
  @@map("daily_challenges")
}

// ----------------------------------------------------------------------------
// Jeu : réponses, parties infinies, stats
// ----------------------------------------------------------------------------

enum GameMode {
  DAILY
  INFINITE
  VERSUS
  EXCLUSIVE // modes Premium (ex. "Pro scene", "Blind 10s")
  ROOM      // salon privé (jusqu'à 8 joueurs)
}

model Guess {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  clipId           String    @map("clip_id") @db.Uuid
  guessedRankId    String    @map("guessed_rank_id") @db.Uuid
  mode             GameMode
  dailyChallengeId String?   @map("daily_challenge_id") @db.Uuid
  infiniteRunId    String?   @map("infinite_run_id") @db.Uuid
  versusMatchId    String?   @map("versus_match_id") @db.Uuid
  roomId           String?   @map("room_id") @db.Uuid
  distance         Int
  score            Int
  xpGained         Int       @map("xp_gained")
  watchedMs        Int       @map("watched_ms")
  /// Temps de réponse mesuré par le serveur : de la remise du clip (jeton de partie) à la réponse. NULL avant son enregistrement
  responseMs       Int?      @map("response_ms")
  /// Duel et salon : XP et statistiques appliquées seulement à la révélation de la manche (rien n'est dévoilé avant)
  statsPending     Boolean   @default(false) @map("stats_pending")
  createdAt        DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip           Clip            @relation(fields: [clipId], references: [id])
  guessedRank    Rank            @relation(fields: [guessedRankId], references: [id])
  dailyChallenge DailyChallenge? @relation(fields: [dailyChallengeId], references: [id])
  infiniteRun    InfiniteRun?    @relation(fields: [infiniteRunId], references: [id])
  versusMatch    VersusMatch?    @relation(fields: [versusMatchId], references: [id], onDelete: Cascade)
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Une seule réponse par joueur et par défi quotidien, donc par jeu et par jour (NULL autorisés pour le mode Infini)
  @@unique([userId, dailyChallengeId])
  @@unique([userId, clipId, infiniteRunId])
  /// Une seule réponse par joueur et par clip d'un duel
  @@unique([userId, versusMatchId, clipId])
  /// Une seule réponse par joueur et par clip d'un salon
  @@unique([userId, roomId, clipId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([clipId])
  @@index([statsPending, createdAt])
  @@map("guesses")
}

model InfiniteRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lives       Int       @default(3)
  difficulty  Int       @default(1)
  score       Int       @default(0)
  clipsPlayed Int       @default(0) @map("clips_played")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses Guess[]

  @@index([userId, score(sort: Desc)])
  @@map("infinite_runs")
}

model UserGameStats {
  userId        String @map("user_id") @db.Uuid
  gameId        String @map("game_id") @db.Uuid
  guesses       Int    @default(0)
  exact         Int    @default(0)
  totalDistance Int    @default(0) @map("total_distance")
  totalScore    Int    @default(0) @map("total_score")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@map("user_game_stats")
}

// ----------------------------------------------------------------------------
// Succès
// ----------------------------------------------------------------------------

enum AchievementCategory {
  PROGRESSION
  STREAK
  ACCURACY
  GAME_EXPERT
  SOCIAL
  SEASON
  VERSUS
  SECRET
}

/// `criteria` est interprété par l'AchievementEngine, ex. :
/// { "type": "exact_guesses", "threshold": 100 }
/// { "type": "daily_streak", "threshold": 7 }
/// { "type": "game_exact", "game": "valorant", "threshold": 50 }
/// { "type": "win_streak", "threshold": 10 }               réponses exactes consécutives
/// { "type": "season_rank", "season": 1, "maxRank": 1 }    attribué à la clôture de la saison (mois)
model Achievement {
  id          String              @id @default(uuid(7)) @db.Uuid
  code        String              @unique
  name        String
  description String
  iconUrl     String?             @map("icon_url")
  category    AchievementCategory
  gameId      String?             @map("game_id") @db.Uuid
  criteria    Json
  xpReward    Int                 @default(0) @map("xp_reward")
  isHidden    Boolean             @default(false) @map("is_hidden")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")

  game  Game?             @relation(fields: [gameId], references: [id])
  users UserAchievement[]
  rewards Cosmetic[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

// ----------------------------------------------------------------------------
// Classements
// Le temps réel vit dans Redis (sorted sets). Cette table archive les
// classements clôturés (jour, semaine, saison) pour l'historique et l'anti-triche.
// ----------------------------------------------------------------------------

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  SEASON
  ALL_TIME
  INFINITE
}

model LeaderboardSnapshot {
  id          String            @id @default(uuid(7)) @db.Uuid
  period      LeaderboardPeriod
  periodKey   String            @map("period_key") // 2026-10-05 (jour) · 2026-10 (saison) · 2026-10:valorant (saison, par jeu)
  userId      String            @map("user_id") @db.Uuid
  position    Int
  score       Int
  createdAt   DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, periodKey, userId])
  @@index([period, periodKey, position])
  @@map("leaderboard_snapshots")
}

// ----------------------------------------------------------------------------
// Modération
// ----------------------------------------------------------------------------

enum ReportReason {
  WRONG_RANK
  INAPPROPRIATE
  LOW_QUALITY
  SPOILER_UI
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(uuid(7)) @db.Uuid
  clipId       String       @map("clip_id") @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  reason       ReportReason
  details      String?      @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  resolverId   String?      @map("resolver_id") @db.Uuid
  resolution   String?
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  clip     Clip  @relation(fields: [clipId], references: [id], onDelete: Cascade)
  reporter User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("resolver", fields: [resolverId], references: [id])

  @@unique([clipId, reporterId])
  @@index([status, createdAt])
  @@map("reports")
}

// ----------------------------------------------------------------------------
// Monétisation, notifications, audit
// ----------------------------------------------------------------------------

enum SubscriptionProvider {
  STRIPE
  APPLE
  GOOGLE_PLAY
  MANUAL // VIP offert depuis l'administration
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @unique @map("user_id") @db.Uuid
  provider         SubscriptionProvider
  externalId       String               @unique @map("external_id")
  plan             String               // premium_monthly | premium_yearly
  status           SubscriptionStatus
  currentPeriodEnd DateTime             @map("current_period_end")
  cancelAtPeriodEnd Boolean             @default(false) @map("cancel_at_period_end")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED // remboursé (Google Play ou équipe) : les jours de VIP correspondants ont été retirés
}

/// Achat d'un pass VIP (boutique) ou VIP offert par l'équipe. Chaque achat payé prolonge l'abonnement de `days` jours.
/// `externalId` = identifiant de la session de paiement Stripe ou jeton d'achat Google Play : garantit qu'un paiement n'est crédité qu'une fois.
model Purchase {
  id          String               @id @default(uuid(7)) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  product     String               // vip_1m | vip_3m | vip_12m | manual
  days        Int
  amountCents Int                  @map("amount_cents")
  currency    String               @default("eur")
  provider    SubscriptionProvider
  externalId  String?              @unique @map("external_id")
  status      PurchaseStatus       @default(PENDING)
  grantedById String?              @map("granted_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  paidAt      DateTime?            @map("paid_at")
  /// Le joueur a demandé l'exécution immédiate et renoncé à son droit de rétractation (contenu numérique, art. L221-28 du Code de la consommation)
  withdrawalWaivedAt DateTime?     @map("withdrawal_waived_at")
  /// Numéro de commande du magasin d'applications (Google Play : GPA.xxxx), utile au support
  orderId     String?              @map("order_id")
  refundedAt  DateTime?            @map("refunded_at")
  /// Achat offert : à un ami (recipientId) ou sous forme de code cadeau (giftCode)
  giftType    GiftType?            @map("gift_type")
  recipientId String?              @map("recipient_id") @db.Uuid

  user      User      @relation("buyer", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?     @relation("granter", fields: [grantedById], references: [id], onDelete: SetNull)
  recipient User?     @relation("giftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  giftCode  GiftCode?

  @@index([userId, createdAt(sort: Desc)])
  @@map("purchases")
}

enum GiftType {
  FRIEND // VIP offert directement à un ami
  CODE   // code cadeau à transmettre
}

/// Code cadeau VIP : acheté pour l'offrir (un seul usage) ou créé par l'équipe (concours, créateurs…, plusieurs usages possibles).
/// Seule l'empreinte SHA-256 sert à la recherche ; le code est aussi gardé chiffré pour être réaffiché à son propriétaire.
model GiftCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  codeHash    String    @unique @map("code_hash")
  codeEnc     String    @map("code_enc")
  days        Int
  maxUses     Int       @default(1) @map("max_uses")
  uses        Int       @default(0)
  expiresAt   DateTime? @map("expires_at")
  purchaseId  String?   @unique @map("purchase_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  /// Raison interne (ex. « concours Discord »)
  note        String?   @db.VarChar(200)
  disabledAt  DateTime? @map("disabled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  purchase    Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("giftCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions GiftRedemption[]

  @@map("gift_codes")
}

model GiftRedemption {
  codeId     String   @map("code_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  code GiftCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([codeId, userId])
  @@index([userId])
  @@map("gift_redemptions")
}

enum Platform {
  IOS
  ANDROID
  WEB
}

model PushToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Toute action d'administration est journalisée (qui, quoi, quand).
/// Journal d'audit : ajout seulement. Un déclencheur PostgreSQL refuse toute modification et toute suppression
/// d'une entrée de moins d'un an (la purge automatique ne retire que les entrées plus anciennes).
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Auteur de l'action ; NULL = action du système (tâche automatique)
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   // clip.approve, user.ban, report.resolve…
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  /// Joueur concerné (historique d'un joueur dans l'administration). Sans clé étrangère : le journal ne change jamais
  targetUserId String?  @map("target_user_id") @db.Uuid
  /// Valeurs avant et après la modification
  before       Json?
  after        Json?
  /// Motif donné par l'équipe
  reason       String?  @db.VarChar(500)
  metadata     Json?
  ip           String?  @db.Inet
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Messagerie privée entre amis
// `conversationKey` = les deux identifiants triés et joints par ":" ; il sert
// d'index unique pour lire l'historique d'une conversation sans OR coûteux.
// ----------------------------------------------------------------------------

model DirectMessage {
  id              String    @id @default(uuid(7)) @db.Uuid
  conversationKey String    @map("conversation_key") @db.VarChar(73)
  senderId        String    @map("sender_id") @db.Uuid
  recipientId     String    @map("recipient_id") @db.Uuid
  body            String    @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")
  readAt          DateTime? @map("read_at")

  sender    User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports   ChatReport[]

  @@index([conversationKey, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("direct_messages")
}

// ----------------------------------------------------------------------------
// Chat global : salon public commun à tous les joueurs connectés.
// Distinct de la messagerie privée. Un message supprimé est masqué (deletedAt),
// pas effacé, pour garder une trace de la modération.
// ----------------------------------------------------------------------------

model GlobalMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  body        String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid
  /// Masqué automatiquement après plusieurs signalements, en attente de décision (rétabli si le signalement est rejeté)
  autoHidden  Boolean   @default(false) @map("auto_hidden")

  user      User  @relation("author", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("moderator", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   ChatReport[]

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("global_messages")
}

// ----------------------------------------------------------------------------
// Duels en direct : deux joueurs voient le même clip au même moment (5 manches de 30 s) ; le meilleur total gagne.
// OPEN    : recherche « joueur au hasard » en attente d'un adversaire (tant que son auteur reste sur la page)
// PENDING : invitation envoyée à un ami, qui doit l'accepter pendant que l'auteur attend
// ACTIVE  : duel en cours (manche courante, début et fin du chrono) · FINISHED : 5 manches jouées ou abandon
// ----------------------------------------------------------------------------

enum VersusStatus {
  OPEN
  PENDING
  ACTIVE
  FINISHED
  DECLINED
  EXPIRED
  CANCELED
}

model VersusMatch {
  id                 String       @id @default(uuid(7)) @db.Uuid
  creatorId          String       @map("creator_id") @db.Uuid
  opponentId         String?      @map("opponent_id") @db.Uuid
  /// Jeu imposé, ou NULL pour des clips de tous les jeux
  gameId             String?      @map("game_id") @db.Uuid
  random             Boolean      @default(false)
  status             VersusStatus
  rounds             Int          @default(5)
  creatorScore       Int          @default(0) @map("creator_score")
  opponentScore      Int          @default(0) @map("opponent_score")
  /// Duel en direct : manche en cours (0 = pas commencé), début (après le compte à rebours) et fin de la manche
  currentRound       Int          @default(0) @map("current_round")
  roundStartsAt      DateTime?    @map("round_starts_at")
  roundEndsAt        DateTime?    @map("round_ends_at")
  /// Joueur qui a abandonné en cours de duel (l'autre gagne)
  forfeitedById      String?      @map("forfeited_by_id") @db.Uuid
  /// NULL si égalité ou duel non terminé
  winnerId           String?      @map("winner_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  acceptedAt         DateTime?    @map("accepted_at")
  finishedAt         DateTime?    @map("finished_at")
  expiresAt          DateTime     @map("expires_at")

  creator  User         @relation("versusCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent User?        @relation("versusOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  winner   User?        @relation("versusWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  game     Game?        @relation(fields: [gameId], references: [id])
  clips    VersusClip[]
  guesses  Guess[]

  @@index([status, gameId, createdAt])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([opponentId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([status, roundEndsAt])
  @@map("versus_matches")
}

model VersusClip {
  matchId  String @map("match_id") @db.Uuid
  position Int
  clipId   String @map("clip_id") @db.Uuid

  match VersusMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clip  Clip        @relation(fields: [clipId], references: [id])

  @@id([matchId, position])
  @@unique([matchId, clipId])
  @@map("versus_clips")
}

// ----------------------------------------------------------------------------
// Signalements de joueurs (chat global, messages privés, profil)
// ----------------------------------------------------------------------------

enum ChatReportReason {
  HARASSMENT
  HATE
  SPAM
  CHEATING
  INAPPROPRIATE_NAME
  INAPPROPRIATE_AVATAR
  OTHER
}

model ChatReport {
  id              String           @id @default(uuid(7)) @db.Uuid
  reporterId      String           @map("reporter_id") @db.Uuid
  targetUserId    String           @map("target_user_id") @db.Uuid
  globalMessageId String?          @map("global_message_id") @db.Uuid
  directMessageId String?          @map("direct_message_id") @db.Uuid
  /// Message du tchat d'un salon ou d'un tournoi
  gameMessageId   String?          @map("game_message_id") @db.Uuid
  reason          ChatReportReason
  details         String?          @db.VarChar(500)
  /// Copie du message signalé au moment du signalement (il peut être supprimé ensuite)
  excerpt         String?          @db.VarChar(1000)
  status          ReportStatus     @default(OPEN)
  resolverId      String?          @map("resolver_id") @db.Uuid
  resolution      String?          @db.VarChar(300)
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  reporter      User           @relation("chatReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target        User           @relation("chatTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  resolver      User?          @relation("chatResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  globalMessage GlobalMessage? @relation(fields: [globalMessageId], references: [id], onDelete: SetNull)
  directMessage DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: SetNull)
  gameMessage   GameChatMessage? @relation(fields: [gameMessageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetUserId])
  @@map("chat_reports")
}

// ----------------------------------------------------------------------------
// Récompenses : titres (sous le pseudo), badges (à côté du pseudo) et cadres d'avatar.
// Obtenues automatiquement (niveau atteint, succès, classement de fin de saison) ou attribuées par l'équipe.
// ----------------------------------------------------------------------------

enum CosmeticType {
  TITLE
  BADGE
  FRAME
}

enum CosmeticSource {
  MANUAL      // attribuée depuis l'administration
  LEVEL       // palier de niveau atteint
  ACHIEVEMENT // succès obtenu
  SEASON      // classement de fin de saison
}

model Cosmetic {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Identifiant stable (ex. title-youtubeur, season-1-champion)
  key         String       @unique
  type        CosmeticType
  name        String       @db.VarChar(40)
  description String?      @db.VarChar(200)
  /// Couleur principale (#RRGGBB) ; cadre : couleur de départ du dégradé
  color       String       @db.VarChar(7)
  /// Cadre : couleur de fin du dégradé (vide = couleur unie)
  color2      String?      @db.VarChar(7)
  /// Badge : icône (clé de la liste BADGE_ICONS)
  icon        String?      @db.VarChar(24)
  /// Obtenue automatiquement en atteignant ce niveau
  unlockLevel Int?         @map("unlock_level")
  /// Obtenue automatiquement avec ce succès
  unlockAchievementId String? @map("unlock_achievement_id") @db.Uuid
  /// Masquée = plus attribuable ni équipable (les joueurs qui l'ont la gardent dans l'historique)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  unlockAchievement Achievement?  @relation(fields: [unlockAchievementId], references: [id], onDelete: SetNull)
  owners            UserCosmetic[]
  titleOf           User[]        @relation("equippedTitle")
  badgeOf           User[]        @relation("equippedBadge")
  frameOf           User[]        @relation("equippedFrame")
  tournamentRewards Tournament[]

  @@index([unlockLevel])
  @@map("cosmetics")
}

model UserCosmetic {
  userId      String         @map("user_id") @db.Uuid
  cosmeticId  String         @map("cosmetic_id") @db.Uuid
  source      CosmeticSource
  grantedAt   DateTime       @default(now()) @map("granted_at")
  grantedById String?        @map("granted_by_id") @db.Uuid
  /// Raison visible par l'équipe (ex. « chaîne YouTube vérifiée »)
  note        String?        @db.VarChar(200)
  /// Le joueur a vu cette nouvelle récompense
  seenAt      DateTime?      @map("seen_at")

  user      User     @relation("owner", fields: [userId], references: [id], onDelete: Cascade)
  cosmetic  Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("granter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, cosmeticId])
  @@index([cosmeticId])
  @@map("user_cosmetics")
}

// ----------------------------------------------------------------------------
// Réglages modifiables depuis l'administration (filtre de mots du chat, mode lent…)
// ----------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedById String? @map("updated_by_id") @db.Uuid

  @@map("app_settings")
}

// ----------------------------------------------------------------------------
// Suggestions des joueurs (idées d'amélioration, réponses de l'équipe)
// ----------------------------------------------------------------------------

enum SuggestionCategory {
  FEATURE // nouvelle fonctionnalité
  GAMEPLAY // modes de jeu, scores, défis
  CONTENT // jeux, rangs, clips
  INTERFACE // site et application
  OTHER
}

enum SuggestionStatus {
  NEW // pas encore traitée
  PLANNED // retenue, prévue
  DONE // réalisée
  DECLINED // non retenue
}

model Suggestion {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  category    SuggestionCategory @default(FEATURE)
  text        String             @db.VarChar(1000)
  status      SuggestionStatus   @default(NEW)
  /// Réponse de l'équipe, visible par l'auteur de la suggestion
  reply       String?            @db.VarChar(500)
  repliedById String?            @map("replied_by_id") @db.Uuid
  repliedAt   DateTime?          @map("replied_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user      User  @relation("suggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  repliedBy User? @relation("suggestionReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("suggestions")
}

// ----------------------------------------------------------------------------
// Saisons (dates libres, gérées dans l'administration)
// ----------------------------------------------------------------------------

model Season {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Identifiant stable des classements et des archives : « 2026-10 » (premières saisons mensuelles), « saison-1 »…
  key            String    @unique @db.VarChar(32)
  /// Numéro affiché (Saison 1, 2…) ; NULL = saison hors numérotation (bêta, événement)
  number         Int?      @unique
  name           String    @db.VarChar(60)
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  /// Récompenses de fin de saison (titres Champion et Podium, badge Top 10, titre du meilleur contributeur)
  rewardsEnabled Boolean   @default(true) @map("rewards_enabled")
  /// Nom et couleur de chaque récompense
  rewards        Json
  /// Clôture : classement archivé et récompenses attribuées
  closedAt       DateTime? @map("closed_at")
  /// Fin de saison du classement compétitif : résultats archivés et cotes réinitialisées (une seule fois)
  competitiveResetAt DateTime? @map("competitive_reset_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  competitiveResults CompetitiveSeasonResult[]

  @@index([startsAt])
  @@map("seasons")
}

// ----------------------------------------------------------------------------
// Salons privés : partie entre amis jusqu'à 8 joueurs, créée par un joueur VIP.
// Seul le créateur doit être VIP ; rejoindre, jouer et voir les résultats est gratuit.
// ----------------------------------------------------------------------------

enum RoomVisibility {
  PUBLIC  // liste des salons, rejoignable sans invitation
  PRIVATE // code ou invitation uniquement
}

enum RoomStatus {
  LOBBY    // salle d'attente : les joueurs rejoignent avec le code
  ACTIVE   // partie en cours
  FINISHED // partie terminée (résultats consultables)
  CLOSED   // salon fermé avant le lancement (hôte parti, inactivité)
}

model Room {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Code d'invitation (8 caractères sans caractères ambigus), unique
  code          String     @unique @db.VarChar(8)
  /// Joueur VIP qui a créé le salon (droit vérifié en base à la création) ; NULL pour un salon par défaut (créé par le serveur)
  /// ou si le compte du créateur a été supprimé
  createdById   String?    @map("created_by_id") @db.Uuid
  /// Hôte actuel : le créateur, puis le joueur présent arrivé le plus tôt s'il part ou se déconnecte (VIP non requis) ;
  /// NULL pour un salon par défaut vide (le premier joueur qui entre devient hôte)
  hostId        String?    @map("host_id") @db.Uuid
  /// Salon par défaut entretenu par le serveur (ex. « CLASSIC:1 ») ; NULL pour un salon créé par un joueur.
  /// Index unique partiel (migration SQL, non exprimable ici) : un seul salon en salle d'attente par emplacement.
  systemSlot    String?    @map("system_slot") @db.VarChar(32)
  /// NULL = tous les jeux (match de tournoi « Tous les jeux ») : chaque manche tire un clip de n'importe quel jeu actif
  gameId        String?    @map("game_id") @db.Uuid
  status        RoomStatus @default(LOBBY)
  rounds        Int
  /// Temps de réponse par manche (secondes) ; allongé pour un clip plus long
  roundSec      Int        @map("round_sec")
  maxPlayers    Int        @default(8) @map("max_players")
  /// Option mort subite : en cas d'égalité en tête à la fin des manches prévues, manches décisives entre les ex aequo
  suddenDeath   Boolean    @default(false) @map("sudden_death")
  /// Public : listé et rejoignable sans invitation ; privé : code ou invitation seulement (salons existants : privés)
  visibility    RoomVisibility @default(PRIVATE)
  /// Duel par équipes : 2 (2 contre 2) ou 3 (3 contre 3) joueurs par équipe ; NULL = chacun pour soi
  teamSize      Int?       @map("team_size")
  /// Mode Intrus : à chaque manche, un joueur reçoit un autre clip ; après les réponses, tout le monde vote
  impostor      Boolean    @default(false)
  /// Étape de la manche en cours : ANSWER (réponses) ou VOTE (mode Intrus) ; la fin de l'étape est round_ends_at
  phase         String     @default("ANSWER") @db.VarChar(8)
  /// Manches de mort subite déjà lancées (3 au maximum)
  suddenDeathRounds Int    @default(0) @map("sudden_death_rounds")
  /// Comment la première place a été attribuée : POINTS, SUDDEN_DEATH, SPEED (réponse la plus rapide), SHARED (égalité conservée)
  decidedBy     String?    @map("decided_by") @db.VarChar(16)
  /// Manche en cours (0 = pas commencé), début (après le compte à rebours) et fin de la manche
  currentRound  Int        @default(0) @map("current_round")
  roundStartsAt DateTime?  @map("round_starts_at")
  roundEndsAt   DateTime?  @map("round_ends_at")
  /// Salle d'attente fermée automatiquement à cette date si la partie n'a pas été lancée
  expiresAt     DateTime   @map("expires_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  startedAt     DateTime?  @map("started_at")
  finishedAt    DateTime?  @map("finished_at")

  createdBy User?        @relation("roomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  host      User?        @relation("roomHost", fields: [hostId], references: [id], onDelete: SetNull)
  game      Game?        @relation(fields: [gameId], references: [id])
  players   RoomPlayer[]
  roundList RoomRound[]
  invites   RoomInvite[]
  guesses   Guess[]
  votes     RoomVote[]
  tournamentMatch TournamentMatch?
  bonuses   RoomBonus[]
  chat      GameChatMessage[]

  @@index([status, expiresAt])
  @@index([status, roundEndsAt])
  @@index([createdById, createdAt(sort: Desc)])
  /// Liste publique et « Jouer maintenant » : salons publics par état et par jeu
  @@index([visibility, status, gameId, createdAt])
  /// Salons par défaut : dernier salon de chaque emplacement (rotation des jeux)
  @@index([systemSlot, createdAt])
  @@map("rooms")
}

model RoomPlayer {
  roomId    String    @map("room_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at")
  /// Départ pendant la partie : le joueur garde ses points mais ne répond plus
  leftAt    DateTime? @map("left_at")
  /// Total recalculé par le serveur à partir des réponses
  score     Int       @default(0)
  /// Place finale (1 = vainqueur, places partagées en cas d'égalité)
  placement Int?
  /// Joueur à égalité en tête qui dispute la mort subite
  finalist  Boolean   @default(false)
  /// Duel par équipes : équipe 1 (bleue) ou 2 (rouge)
  team      Int?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("room_players")
}

model RoomRound {
  roomId   String @map("room_id") @db.Uuid
  position Int
  clipId   String @map("clip_id") @db.Uuid
  /// Manche décisive (mort subite) : seuls les joueurs à égalité en tête y répondent, ses points ne s'ajoutent pas au total
  suddenDeath Boolean @default(false) @map("sudden_death")
  /// Mode Intrus : joueur qui reçoit l'autre clip, et ce clip (jamais dévoilés avant la fin du vote)
  impostorId  String? @map("impostor_id") @db.Uuid
  altClipId   String? @map("alt_clip_id") @db.Uuid

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  clip Clip @relation(fields: [clipId], references: [id])

  @@id([roomId, position])
  @@unique([roomId, clipId])
  @@map("room_rounds")
}

/// Invitation d'un ami dans un salon (valable tant que le salon est en salle d'attente)
model RoomInvite {
  roomId      String   @map("room_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  invitedById String   @map("invited_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation("roomInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("roomInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_invites")
}

// ----------------------------------------------------------------------------
// Plus haut / Plus bas : le rang du clip suivant est-il plus haut ou plus bas que celui du clip affiché ?
// Une erreur termine la série. 3 séries gratuites par jour, illimitées en VIP.
// ----------------------------------------------------------------------------

model HigherLowerRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  gameId        String    @map("game_id") @db.Uuid
  /// Bonnes réponses d'affilée
  score         Int       @default(0)
  /// Question en cours (1 = première comparaison) : une réponse n'est acceptée qu'une fois par question
  round         Int       @default(1)
  /// Clip affiché avec son rang
  currentClipId String    @map("current_clip_id") @db.Uuid
  /// Clip à comparer (rang caché jusqu'à la réponse) ; NULL une fois la série terminée
  nextClipId    String?   @map("next_clip_id") @db.Uuid
  /// Clips déjà montrés dans la série (jamais deux fois le même)
  usedClipIds   String[]  @default([]) @map("used_clip_ids") @db.Uuid
  /// Fin de la série : WRONG (mauvaise réponse), COMPLETE (plus de clip à comparer), ABANDONED (nouvelle série lancée)
  endReason     String?   @map("end_reason") @db.VarChar(16)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, score(sort: Desc)])
  @@map("higher_lower_runs")
}

/// Mode Intrus : vote d'un joueur pour désigner l'intrus d'une manche (un seul vote par joueur et par manche)
model RoomVote {
  roomId    String   @map("room_id") @db.Uuid
  round     Int
  voterId   String   @map("voter_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, round, voterId])
  @@map("room_votes")
}

/// Points attribués en plus des réponses (mode Intrus : intrus démasqué ou non), une ligne par joueur et par manche
model RoomBonus {
  roomId String @map("room_id") @db.Uuid
  round  Int
  userId String @map("user_id") @db.Uuid
  points Int
  /// IMPOSTOR_FOUND (bon vote) ou IMPOSTOR_HIDDEN (intrus non démasqué)
  reason String @db.VarChar(20)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, round, userId])
  @@map("room_bonuses")
}

// ----------------------------------------------------------------------------
// Tournois privés : tableau à élimination directe, matchs joués dans des salons à 2.
// Seul le créateur doit être VIP ; les participants s'inscrivent et jouent gratuitement.
// ----------------------------------------------------------------------------

enum TournamentStatus {
  LOBBY    // inscriptions ouvertes (code d'invitation)
  ACTIVE   // tableau en cours
  FINISHED // vainqueur connu, classement final
  CLOSED   // fermé avant le lancement
}

model Tournament {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Code d'invitation (même format que les salons), unique
  code        String           @unique @db.VarChar(8)
  /// Joueur VIP qui a créé le tournoi (droit vérifié en base à la création)
  createdById String           @map("created_by_id") @db.Uuid
  /// Hôte actuel : lance le tableau ; le joueur inscrit le plus tôt s'il part avant le lancement
  hostId      String           @map("host_id") @db.Uuid
  /// NULL = tous les jeux : les clips des matchs viennent de tous les jeux actifs
  gameId      String?          @map("game_id") @db.Uuid
  /// Places : 4, 8 ou 16 (tournoi d'un joueur VIP) ; jusqu'à 64 pour un événement
  capacity    Int
  /// Public : listé dans la page Tournois et rejoignable sans code ; privé : code d'invitation seulement (événements : publics)
  visibility  RoomVisibility   @default(PRIVATE)
  /// Événement créé par l'administration : visible par tous, sans organisateur inscrit, récompense pour le vainqueur
  isEvent     Boolean          @default(false) @map("is_event")
  /// Nom de l'événement (affiché à la place de « Tournoi »)
  title       String?          @db.VarChar(60)
  /// Récompense du vainqueur : titre, badge ou cadre, et/ou jours de VIP ; donnée une seule fois (rewardGrantedAt)
  rewardCosmeticId String?     @map("reward_cosmetic_id") @db.Uuid
  rewardVipDays    Int?        @map("reward_vip_days")
  rewardGrantedAt  DateTime?   @map("reward_granted_at")
  /// Événement programmé : lancé automatiquement à cette heure (s'il y a assez d'inscrits), rappel 10 minutes avant
  startsAt         DateTime?   @map("starts_at")
  reminderSentAt   DateTime?   @map("reminder_sent_at")
  /// Taille du tableau au lancement (puissance de 2 suffisante pour les inscrits)
  bracketSize Int?             @map("bracket_size")
  /// Manches par match et temps de réponse par manche
  rounds      Int
  roundSec    Int              @map("round_sec")
  status      TournamentStatus @default(LOBBY)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  startedAt   DateTime?        @map("started_at")
  finishedAt  DateTime?        @map("finished_at")

  createdBy User               @relation("tournamentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  host      User               @relation("tournamentHost", fields: [hostId], references: [id], onDelete: Cascade)
  game      Game?              @relation(fields: [gameId], references: [id])
  players   TournamentPlayer[]
  matches   TournamentMatch[]
  chat      GameChatMessage[]
  rewardCosmetic Cosmetic?    @relation(fields: [rewardCosmeticId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([isEvent, status])
  @@index([visibility, status])
  @@index([status, startsAt])
  @@map("tournaments")
}

model TournamentPlayer {
  tournamentId String    @map("tournament_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  joinedAt     DateTime  @default(now()) @map("joined_at")
  /// Tête de série tirée au sort au lancement (1 = meilleure)
  seed         Int?
  /// A quitté le tournoi après le lancement (ses matchs sont perdus par forfait)
  leftAt       DateTime? @map("left_at")
  /// Place finale (1 = vainqueur ; places partagées entre éliminés d'un même tour)
  placement    Int?
  /// Réduit au silence dans le tchat du tournoi par l'organisateur ou l'équipe de modération
  chatMuted    Boolean   @default(false) @map("chat_muted")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("tournament_players")
}

model TournamentMatch {
  id           String    @id @default(uuid(7)) @db.Uuid
  tournamentId String    @map("tournament_id") @db.Uuid
  /// Tour (1 = premier tour) et emplacement dans le tour
  stage        Int
  slot         Int
  player1Id    String?   @map("player1_id") @db.Uuid
  player2Id    String?   @map("player2_id") @db.Uuid
  /// « Je suis prêt » de chaque joueur ; le match démarre quand les deux le sont
  ready1At     DateTime? @map("ready1_at")
  ready2At     DateTime? @map("ready2_at")
  /// Heure limite pour être prêt, une fois les deux adversaires connus
  deadlineAt   DateTime? @map("deadline_at")
  /// Salon du match (créé et lancé quand les deux joueurs sont prêts)
  roomId       String?   @unique @map("room_id") @db.Uuid
  winnerId     String?   @map("winner_id") @db.Uuid
  /// POINTS, SUDDEN_DEATH, SPEED, SEED, FORFEIT, NO_SHOW ou BYE
  decidedBy    String?   @map("decided_by") @db.VarChar(12)
  score1       Int?
  score2       Int?
  finishedAt   DateTime? @map("finished_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  room       Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, stage, slot])
  @@index([deadlineAt])
  @@map("tournament_matches")
}

// ----------------------------------------------------------------------------
// Classement compétitif (cote Elo par jeu et globale), alimenté uniquement par les duels « au hasard ».
// ----------------------------------------------------------------------------

model CompetitiveRating {
  userId    String   @map("user_id") @db.Uuid
  /// "global" ou le slug d'un jeu
  scope     String   @db.VarChar(20)
  rating    Int      @default(500)
  /// Meilleure cote de la saison en cours
  peak      Int      @default(500)
  /// Duels admissibles comptés dans la saison en cours (éligibilité au classement : 5 au moins)
  games     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  /// Duels admissibles comptés depuis le premier duel, toutes saisons confondues (coefficient de placement)
  careerGames Int    @default(0) @map("career_games")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@index([scope, rating(sort: Desc)])
  @@map("competitive_ratings")
}

/// Historique de la cote : une ligne par joueur, périmètre et duel (jamais deux fois le même duel)
model RatingChange {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  scope      String   @db.VarChar(20)
  matchId    String   @map("match_id") @db.Uuid
  opponentId String   @map("opponent_id") @db.Uuid
  /// WIN, LOSS ou DRAW
  result     String   @db.VarChar(4)
  before     Int
  after      Int
  delta      Int
  /// false : sans effet sur la cote (voir reason)
  counted    Boolean
  /// Duel non compté : PAIR_LIMIT (plus de 3 duels contre ce même adversaire en 24 h) ou EARLY_FORFEIT (abandon avant la fin de la 1re manche)
  reason     String?  @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, matchId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, opponentId, createdAt])
  @@map("rating_changes")
}

/// Archive du classement compétitif à la fin d'une saison : cote finale, rang, place et cote de départ de la saison suivante
model CompetitiveSeasonResult {
  seasonId  String   @map("season_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  scope     String   @db.VarChar(20)
  rating    Int
  peak      Int
  /// Rang atteint (clé de l'échelle partagée : BRONZE … MASTER)
  tier      String   @db.VarChar(12)
  /// Place finale (NULL : moins de 5 duels dans la saison, non classé)
  placement Int?
  games     Int
  wins      Int
  losses    Int
  draws     Int
  /// Cote de départ de la saison suivante (seuil du rang atteint)
  resetTo   Int      @map("reset_to")
  createdAt DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([seasonId, userId, scope])
  @@index([seasonId, scope, placement])
  @@index([userId])
  @@map("competitive_season_results")
}

// ----------------------------------------------------------------------------
// Tchat d'un salon (salle d'attente et partie ; canal d'équipe en duel par équipes) ou d'un tournoi (jusqu'à sa fin)
// ----------------------------------------------------------------------------

model GameChatMessage {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Salon ou tournoi (un seul des deux)
  roomId       String?   @map("room_id") @db.Uuid
  tournamentId String?   @map("tournament_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Canal d'équipe (1 ou 2) en duel par équipes : lu seulement par cette équipe ; NULL = tout le salon
  team         Int?
  body         String    @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Supprimé par son auteur, l'organisateur du tournoi ou l'équipe de modération (plus affiché)
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  room       Room?       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports    ChatReport[]

  @@index([roomId, createdAt])
  @@index([tournamentId, createdAt])
  @@index([userId])
  @@map("game_chat_messages")
}