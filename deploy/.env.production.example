# Configuration de production. Copier en .env.production (jamais dans Git) puis compléter.
# Générer chaque secret avec :  openssl rand -base64 48

# ---------- Domaines (enregistrements DNS de type A vers l'adresse IP du serveur) ----------
WEB_DOMAIN=rankguess.fr
API_DOMAIN=api.rankguess.fr
ADMIN_DOMAIN=admin.rankguess.fr
# Email de contact pour Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# ---------- Base de données et cache ----------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BACKUP_KEEP_DAYS=14

# ---------- Sécurité ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Double authentification pour l'administration : false = facultative (chaque membre peut l'activer sur son compte),
# true = obligatoire pour la modération et l'administration
ADMIN_REQUIRE_2FA=false

# ---------- Jeu ----------
SEASON_ONE=2026-10
APP_SCHEME=ranksight

# ---------- Stockage des vidéos : Cloudflare R2 ----------
# S3_ENDPOINT sert aussi au site et à l'administration (envoi direct depuis le navigateur, autorisé dans leur CSP) :
# après l'avoir changé, reconstruire web et admin (build admin web, puis up -d admin web).
# Règle CORS du bucket (R2 → bucket → Settings → CORS policy) : origines https://<WEB_DOMAIN>, https://www.<WEB_DOMAIN>
# et https://<ADMIN_DOMAIN> ; méthodes GET, HEAD, PUT ; en-têtes autorisés * ; en-tête exposé ETag ; durée 3600.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<id-de-compte>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rankguess-clips
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Emails (Brevo, Resend, Mailjet…) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RankGuess <no-reply@rankguess.fr>"
CONTACT_EMAIL=

# ---------- Connexion Google / Discord (facultatif) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------- Paiement (Stripe, mode Live) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Achats dans l'application Android (Google Play Billing) ----------
GOOGLE_PLAY_PACKAGE_NAME=com.rankguess.app
# Clé JSON du compte de service encodée en base64 : base64 -w0 cle.json
GOOGLE_PLAY_SERVICE_ACCOUNT=

# ---------- Suivi des erreurs (Sentry, facultatif) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Informations légales (mentions légales, CGV, confidentialité) ----------
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS="Entrepreneur individuel (micro-entreprise)"
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_SIRET=
LEGAL_VAT_NOTE="TVA non applicable, article 293 B du Code général des impôts"
LEGAL_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_CONTACT=
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
